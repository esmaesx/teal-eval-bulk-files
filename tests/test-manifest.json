{
  "manifest_version": 3,
  "name": "Teal Eval Bulk Files",
  "version": "0.9.6",
  "description": "Adds safe bulk upload, bulk download, and bulk delete controls to Teal Alpha eval issue pages.",
  "permissions": [
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://platform-teal-alpha.vercel.app/*",
    "http://127.0.0.1:8769/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://platform-teal-alpha.vercel.app/issue/*",
        "http://127.0.0.1:8769/issue/*"
      ],
      "js": [
        "zip-builder.js",
        "bridge-plan-store.js",
        "delete-apply-envelope.js",
        "upload-lifetime.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
